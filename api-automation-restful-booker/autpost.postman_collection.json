							"    pm.expect(body.bookingid).to.be.a(\"number\");",
							"});",
							"",
							"pm.test(\"Returned data matches the request\", () => {",
							"    pm.expect(body.booking.firstname).to.eql(\"John\");",
							"    pm.expect(body.booking.lastname).to.eql(\"Tester\");",
							"    pm.expect(body.booking.totalprice).to.eql(150);",
							"    pm.expect(body.booking.bookingdates.checkin).to.eql(\"2026-11-01\");",
							"    pm.expect(body.booking.bookingdates.checkout).to.eql(\"2026-11-05\");",
