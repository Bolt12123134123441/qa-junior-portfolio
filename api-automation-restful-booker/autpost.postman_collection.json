		{
			"name": "[TC-BKG-010] PATCH /booking/:id - partial update with valid token",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const randomId = Math.floor(Math.random() * 1000);",
							"",
							"const newFirstname = \"Jim_\" + randomId;",
							"const newLastname = \"Brown_\" + randomId;",
							"const newPrice = Math.floor(Math.random() * 300) + 100;",
							"",
							"pm.collectionVariables.set(\"randomFirstname\", newFirstname);",
							"pm.collectionVariables.set(\"randomLastname\", newLastname);",
							"pm.collectionVariables.set(\"randomPrice\", newPrice);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const body = pm.response.json();",
							"",
							"",
							"",
							"",
							"",
							"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
							"",
							"",
							"",
							"const sentFirstName = pm.collectionVariables.get(\"randomFirstname\");",
							"const sentLanstName = pm.collectionVariables.get(\"randomLastname\");",
							"const sentPrice = pm.collectionVariables.get(\"randomPrice\");",
							"",
							"",
							"pm.test(\"Only the sent field is changed\", () => {",
							"    pm.expect(body.firstname).to.eql(sentFirstName);",
							"    pm.expect(body.lastname).to.eql(sentLanstName);",
							"    pm.expect(body.totalprice).to.eql(sentPrice);",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
